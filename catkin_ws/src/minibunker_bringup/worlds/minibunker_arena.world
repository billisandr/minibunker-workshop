<?xml version="1.0"?>
<!-- ==========================================================================
     minibunker_arena.world — self-contained Gazebo Classic world (plan.md §8.5).

     This world holds ONLY the ground plane, lighting and physics. EVERY prop
     (ball, cones, fence) is defined in one place — the `arena:` block at the
     bottom of config/minibunker.yaml — and spawned at launch by arena_setup.py
     (one at a time, via /gazebo/spawn_sdf_model, to dodge a Gazebo/Ogre race
     when several identical cone meshes load at once). Cones use the real
     model://construction_cone mesh, vendored into the image at build time under
     ~/.gazebo/models (docker/Dockerfile), so the sim runs with zero network
     access. See docs/ARENA.md for the object schema.
     ========================================================================== -->
<sdf version="1.6">
  <world name="minibunker_arena">

    <include><uri>model://sun</uri></include>

    <!-- dark mining-floor ground -->
    <model name="arena_floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- All props (ball, cones, fence) are spawned at launch by arena_setup.py
         from the `arena:` block at the bottom of config/minibunker.yaml. Nothing
         object-related is baked into this world. -->

    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  </world>
</sdf>
