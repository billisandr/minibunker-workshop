<?xml version="1.0"?>
<!-- ==========================================================================
     minibunker_arena.world — self-contained Gazebo Classic world (plan.md §8.5).

     This world holds ONLY physics + a baseline ambient. EVERY object — the
     floor, the sun light, the ball, cones and fence — is defined in one place,
     the `arena:` block at the bottom of config/minibunker.yaml, and spawned at
     launch by arena_setup.py (one at a time, via /gazebo/spawn_sdf_model, to
     dodge a Gazebo/Ogre race when several identical cone meshes load at once).
     Cones use the real model://construction_cone mesh, vendored into the image
     at build time under ~/.gazebo/models (docker/Dockerfile), so the sim runs
     with zero network access. The <scene> ambient below is just a safety floor
     so the scene is never pitch black if the spawned sun is disabled/changed.
     See docs/ARENA.md for the object schema.
     ========================================================================== -->
<sdf version="1.6">
  <world name="minibunker_arena">

    <!-- baseline ambient only; the directional "sun" is spawned from the yaml -->
    <scene><ambient>0.3 0.3 0.3 1</ambient><background>0.6 0.6 0.65 1</background></scene>

    <!-- Floor, sun and all props are spawned at launch by arena_setup.py from
         the `arena:` block at the bottom of config/minibunker.yaml. Nothing
         object-related is baked into this world. -->

    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  </world>
</sdf>
