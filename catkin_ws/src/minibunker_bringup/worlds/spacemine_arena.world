<?xml version="1.0"?>
<!-- ==========================================================================
     spacemine_arena.world — self-contained Gazebo Classic world (plan.md §8.5).

     Cones and the fence are NOT baked into this static world -- both are spawned
     at launch by arena_setup.py (sequentially, via /gazebo/spawn_sdf_model), so
     their presence/size stays config-driven (arena/fence_enabled, arena/cone_scale
     in minibunker.yaml) and spawning one model at a time avoids a real Gazebo/Ogre
     race seen when 3 copies of the same mesh+texture load concurrently off a
     single static <include>. Cones use the real model://construction_cone mesh,
     vendored into the image at build time under ~/.gazebo/models (docker/Dockerfile)
     so this still runs with zero network access at sim runtime. The green "ore"
     ball stays an SDF primitive (a bright-green sphere) since no equivalent
     off-the-shelf mesh is needed there. All props are static so they stay put
     under the kinematic planar-move drive.
     ========================================================================== -->
<sdf version="1.6">
  <world name="spacemine_arena">

    <include><uri>model://sun</uri></include>

    <!-- dark mining-floor ground -->
    <model name="arena_floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fenced boundary is NOT baked into this world. It is spawned at launch
         by arena_setup.py iff config key arena/fence_enabled is true (default
         false) -- see minibunker_bringup/scripts/arena_setup.py, which holds
         the exact same four-wall SDF that used to live here. -->

    <!-- green "ore" ball -->
    <model name="ore_ball">
      <static>true</static>
      <pose>2.6 0.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.05 0.6 0.05 1</ambient><diffuse>0.1 0.9 0.1 1</diffuse><emissive>0.0 0.2 0.0 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- "cone" obstacles: spawned by arena_setup.py (see top-of-file note). -->

    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  </world>
</sdf>
