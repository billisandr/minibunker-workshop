<?xml version="1.0"?>
<!-- ==========================================================================
     minibunker_sim.launch — the SIM half of the station (plan.md §4.5, §8.4).

     Gazebo spacemine arena + Bunker (with our added camera plugin) + detector
     + behaviour + rosbridge. The Gazebo camera plugin publishes /camera/image_raw
     and the Bunker's planar-move plugin consumes /cmd_vel and emits /odom — the
     exact same topic contract the real robot uses, so detector/behaviour are
     identical across sim and real.

       roslaunch minibunker_bringup minibunker_sim.launch backend:=hsv|cnn
     ========================================================================== -->
<launch>
  <arg name="backend"      default="hsv"/>     <!-- hsv | cnn -->
  <arg name="paused"       default="false"/>
  <arg name="gui"          default="true"/>
  <arg name="headless"     default="false"/>
  <arg name="rosbridge"    default="true"/>
  <arg name="world"        default="$(find minibunker_bringup)/worlds/spacemine_arena.world"/>

  <!-- 1. Master config, then launch-arg overrides -->
  <include file="$(find minibunker_bringup)/launch/params.launch"/>
  <param name="detector/backend" value="$(arg backend)"/>
  <param name="camera/source"    value="gazebo"/>

  <!-- 2. Gazebo world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="$(arg headless)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- 3. Robot: Bunker description + our camera seam -->
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder '$(find minibunker_bringup)/urdf/minibunker.urdf.xacro'"/>
  <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -model minibunker -param robot_description -x 0 -y 0 -z 0.2 -unpause"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- 4. Perception + behaviour (identical to the real launch) -->
  <node name="detector" pkg="minibunker_perception" type="detector_node.py" output="screen"/>
  <node name="behavior" pkg="minibunker_behavior"   type="behavior_node.py" output="screen"/>

  <!-- 5. rosbridge for the Streamlit UI -->
  <group if="$(arg rosbridge)">
    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/>
  </group>
</launch>
